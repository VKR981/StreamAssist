{
  "name": "twitch-copilot",
  "version": "0.3.5",
  "description": "Local Twitch Copilot plugin for OpenAI Codex with MCP integration",
  "type": "module",
  "main": "build/server.cjs",
  "bin": {
    "twitch-copilot": "build/server.cjs",
    "twitch-copilot-setup": "build/setup-auth.cjs"
  },
  "scripts": {
    "start": "node build/server.cjs",
    "demo": "node scripts/demo.js",
    "test": "node --test test/**/*.test.js",
    "validate": "node scripts/validate.js",
    "package": "node scripts/build.js && node scripts/validate.js && node scripts/package.js",
    "setup-auth": "node build/setup-auth.cjs",
    "build": "node scripts/build.js"
  },
  "keywords": [
    "codex",
    "codex-plugin",
    "twitch",
    "mcp",
    "chat",
    "eventsub",
    "streaming"
  ],
  "author": "Twitch Copilot Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
